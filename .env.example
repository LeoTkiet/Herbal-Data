# ==========================================
# ENVIRONMENT CONFIGURATION FOR HERBAL DATA SCRAPING AGENT
# ==========================================

# 1. MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/

# 2. Comma-separated list of Gemini API Keys
# The Key Pool automatically rotates upon receiving error 429 (ResourceExhausted)
GEMINI_KEYS=AIzaSyD_EXAMPLE_KEY_1,AIzaSyD_EXAMPLE_KEY_2,AIzaSyD_EXAMPLE_KEY_3

# 3. Gemini Model to use (Default: gemini-3.6-flash)
# Options: gemini-3.6-flash, gemini-2.5-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-3.6-flash
