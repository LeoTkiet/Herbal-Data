# ==========================================
# CẤU HÌNH MÔI TRƯỜNG CHO HERBAL DATA SCRAPING AGENT
# ==========================================

# 1. MongoDB Connection URI (Local hoặc MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/

# 2. Danh sách Gemini API Keys (phân tách bởi dấu phẩy)
# Pool sẽ tự động luân chuyển khi gặp lỗi Quota 429 (ResourceExhausted)
GEMINI_KEYS=AIzaSyD_EXAMPLE_KEY_1,AIzaSyD_EXAMPLE_KEY_2,AIzaSyD_EXAMPLE_KEY_3

# 3. Model Gemini sử dụng (Mặc định: gemini-2.5-flash)
# Tùy chọn: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-flash-latest, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
